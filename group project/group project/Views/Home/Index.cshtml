@{
    ViewData["Title"] = "Contact Manager";
}

<div class="contact-banner">
    <h1>Contact Manager</h1>
</div>

<div class="mb-2">
    <a asp-controller="Contact" asp-action="Add">Add Contact</a>
</div>

<table class="table table-borderless border-bottom"> 
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Category</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var contacts in Model)
        {
            <tr>
                <td>
                    <a asp-controller="Contact" asp-action="Details"
                       asp-route-id="@contacts.ContactId"
                       asp-route-slug="@contacts.Slug">
                        @contacts.FirstName
                    </a>
                </td>
                <td>
                    <a asp-controller="Contact" asp-action="Details"
                       asp-route-id="@contacts.ContactId"
                       asp-route-slug="@contacts.Slug">
                        @contacts.LastName
                    </a>
                </td>
                <td>@contacts.Phone</td>
                <td>@contacts.Email</td>
                <td>@contacts.Category.CategoryName</td>
            </tr>
        }
    </tbody>
</table>